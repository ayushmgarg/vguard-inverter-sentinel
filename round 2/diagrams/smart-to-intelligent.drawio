        <mxCell id="t" value="From Smart Products to Intelligent Products" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1090" height="30" as="geometry"/></mxCell>
        <mxCell id="smart" value="TODAY: “SMART” products&#10;(connected, but reactive)&#10;&#10;• App / Wi-Fi / Alexa control&#10;• Remote on/off &amp; manual modes&#10;• Shows present state only&#10;• Cloud-dependent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="360" height="320" as="geometry"/></mxCell>
